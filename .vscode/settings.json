{
  // 核心性能优化
  "C_Cpp.intelliSenseEngine": "disabled", // 确认使用默认引擎
  "C_Cpp.intelliSenseCacheSize": 4096, // 增大缓存（单位 MB）
  "C_Cpp.intelliSenseCachePath": "${workspaceFolder}/.vscode/ipch", // 缓存位置
  "C_Cpp.doxygen.generateOnType": true,
  "C_Cpp.doxygen.generatedStyle": "/**",
  "workbench.editor.revealIfOpen": true,

  // 减少扫描范围
  "C_Cpp.files.exclude": {
    "**/build": true,
    "**/out": true,
    "**/.git": true,
    "**/thirdparty": true
  },

  "files.watcherExclude": {
    "**/build/**": true,
    "**/out/**": true,
    "**/.git/objects/**": true
  },

  //告诉 clangd 编译数据库在 build 目录下
  "clangd.arguments": [
    "--compile-commands-dir=build",
    "--background-index",
    "--clang-tidy",
    "--header-insertion=never"
    // "--log=verbose"
  ],

  "editor.formatOnSave": true,

  // CMake Tools：禁用插件的 vcpkg 自动接管，
  // 改用 CMakePresets.json 里 $env{VCPKG_ROOT} 解析出的 toolchain
  // （本机 VCPKG_ROOT = D:\Tools\vcpkg\vcpkg，对应 vcpkg.cmake 真实存在）
  "cmake.useCMakePresets": "never",
  "cmake.useVcpkg": false,

  // 明确使用 clangd 作为 C/C++ 格式化器
  // clangd 会自动从当前文件向上查找并应用项目根目录的 .clang-format
  "[c]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },
  "C_Cpp.default.intelliSenseMode": "clang-x64",
  "cmake.cpptools.intelliSenseMode": "clang-x64",
  "cmake.additionalBuildProblemMatchers": [],

  // 集成终端配置
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell"
    },
    "Command Prompt": {
      "path": ["${env:windir}\\System32\\cmd.exe"]
    }
  },
  "terminal.integrated.automationProfile.windows": {
    "path": "powershell.exe",
    "args": ["-NoProfile"]
  },

  "qtConfigure.qtDir": "D:\\InstallDir\\Qt6.7\\6.7.3\\msvc2022_64",

  // Qt 官方扩展 (theqtcompany.qt-core / theqtcompany.qt-qml) 及 QML 语言服务器配置
  "qt-core.qtInstallationRoot": "D:\\InstallDir\\Qt6.7\\6.7.3",
  "qt-core.additionalQtPaths": ["D:\\InstallDir\\Qt6.7\\6.7.3\\msvc2022_64"],
  "qt-qml.qmlls.customExePath": "D:\\InstallDir\\Qt6.7\\6.7.3\\msvc2022_64\\bin\\qmlls.exe",
  "qt-qml.qmlls.additionalImportPaths": [
    "D:/InstallDir/Qt6.7/6.7.3/msvc2022_64/qml",
    "${workspaceFolder}/UI/qml",
    "${workspaceFolder}/build/debug/UI",
    "${workspaceFolder}/build/debug/UI/NovelMedical/UI"
  ],
  "qt-qml.qmlls.useQmlImportPathEnvVar": true,
  "qt-qml.preview.additionalBuildDirs": ["${workspaceFolder}/build/debug"],
  "qml.importPaths": [
    "D:/InstallDir/Qt6.7/6.7.3/msvc2022_64/qml",
    "${workspaceFolder}/UI/qml",
    "${workspaceFolder}/build/debug/UI"
  ]
}
