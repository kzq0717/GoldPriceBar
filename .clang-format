BasedOnStyle: LLVM
Language: Cpp
Standard: Cpp11

# ── 关闭 include 排序 / 重排（覆盖 LLVM 默认） ───
# 项目中保存格式化时不要动头文件顺序。
IncludeBlocks: Preserve       # 保留原始 #include 分块，不合并不重排
SortIncludes: Never            # 不对 #include 行排序
IncludeCategories: []          # 不按类别重排（仅当 IncludeBlocks 非 Preserve 时才生效，置空以防兜底）

IndentWidth: 4
TabWidth: 4
UseTab: Never

BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline # None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

AlignAfterOpenBracket: false
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false

SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1
SpacesInAngles: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInContainerLiterals: false

AlignTrailingComments:
  Kind: Always        # 开启尾随注释对齐（Always / Leave / Never）
  OverEmptyLines: 0   # 跨空行时是否保持对齐，0 表示遇到空行即分段对齐
  
ColumnLimit: 120
